{
  "name": "taif-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/prune-fixtures.mjs && node scripts/patch-csp.mjs",
    "verify:budget": "node scripts/check-budget.mjs",
    "verify:csp": "node scripts/csp-check.mjs",
    "optimize:images": "node scripts/optimize-screenshots.mjs",
    "preview": "astro preview",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "astro": "5.18.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "2.1.9"
  }
}
