---
/**
 * Downloads section wrapper (T035). Without JavaScript the section degrades to
 * an honest plain link to the GitHub Releases page (no fabricated data).
 */
import type { Locale, Dictionary } from "@/content/types";
import { releasesUrl } from "@/config/site";
import DownloadCenter from "@/components/DownloadCenter";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
---

<section id="downloads" class="container scroll-mt-[84px] py-16">
  <div class="rounded-[16px] border border-border bg-gradient-to-b from-card to-background p-6 shadow-xl sm:p-8">
    <h2 class="text-2xl font-extrabold tracking-[-0.03em] text-foreground sm:text-3xl [&:lang(ar)]:tracking-normal">
      {dict.downloads.heading}
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-muted-foreground">{dict.downloads.intro}</p>
    <noscript>
      <p class="mt-4 text-sm text-muted-foreground">
        {dict.downloads.releasesPage}:
        <a href={releasesUrl} rel="noopener noreferrer" class="underline">{releasesUrl}</a>
      </p>
    </noscript>
    <div class="mt-6">
      <DownloadCenter client:load locale={locale} dict={dict} />
    </div>
  </div>
</section>
