---
/**
 * FAQ section (US5, T064): native <details>/<summary> — toggles with
 * keyboard (Enter/Space) and announces state to screen readers with no
 * custom JS needed.
 */
import type { Dictionary } from "@/content/types";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="faq" class="container scroll-mt-[84px] py-12">
  <h2 class="text-2xl font-extrabold tracking-[-0.03em] text-foreground [&:lang(ar)]:tracking-normal">
    {dict.faq.heading}
  </h2>
  <div class="mt-6 space-y-2.5">
    {
      dict.faq.items.map((item) => (
        <details
          class="group rounded-[12px] border border-border bg-card px-5 py-4 transition-all duration-200 open:bg-secondary/40"
          id={`faq-${item.id}`}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded text-sm font-semibold text-foreground marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background">
            <span>{item.question}</span>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 ease-out group-open:rotate-180"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p class="mt-3 max-w-[68ch] border-t border-border/60 pt-3 text-sm leading-relaxed text-muted-foreground">
            {item.answer}
          </p>
        </details>
      ))
    }
  </div>
</section>
