---
import type { Locale } from "@/content/types";
import type { Dictionary } from "@/content/types";
import Base from "@/layouts/Base.astro";
import { en } from "@/content/en";
import { ar } from "@/content/ar";
import { localePath } from "@/lib/i18n";

const dicts: Record<Locale, Dictionary> = { en, ar };
const dict = dicts.en;
const links: { locale: Locale; dict: Dictionary }[] = [
  { locale: "en", dict },
  { locale: "ar", dict: dicts.ar },
];
---

<Base locale="en" dict={dict} path="/404">
  <main id="main" class="container grid min-h-screen place-items-center text-center">
    <div>
      <h1 class="text-3xl font-bold">{dict.notFound.title}</h1>
      <p class="mt-3 text-muted-foreground">{dict.notFound.body}</p>
      <p class="mt-6 flex justify-center gap-4">
        {
          links.map((l) => (
            <a href={localePath(l.locale)} lang={l.locale} class="underline">
              {l.locale === "en" ? dict.notFound.home : dict.notFound.homeAr}
            </a>
          ))
        }
      </p>
    </div>
  </main>
</Base>
